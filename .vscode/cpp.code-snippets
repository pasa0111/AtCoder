		"prefix": "sieve",
		"body": [
		"// n以下の正整数が素数であるかをbool配列P(n+1)に保存",
		"void sieve(ll n, vector<bool>& P){",
		"    P.assign(n+1,true);",
		"    P[0] = false; P[1] = false;",
		"    for(ll i = 2; i*i <= n; i++){",
		"        if(P[i]) for(ll j = i*i; j <= n; j += i) P[j] = false;",
		"    }",
		"    return;",
		"}"
