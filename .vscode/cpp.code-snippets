      "            if (low[v] == ord[v]) {",
      "                while (true) {",
      "                    int u = node_stack.back();",
      "                    node_stack.pop_back();",
      "                    ord[u] = _n;",
      "                    ids[u] = group_num;",
      "                    if (u == v) break;",
      "                }",
      "                group_num++;",
      "            }",
      "        };",
      "",
      "        for (int i = 0; i < _n; i++) {",
      "            if (ord[i] == -1) dfs(dfs, i);",
      "        }",
      "",
      "        for (auto& x : ids) x = group_num - 1 - x;",
      "        std::vector<int> counts(group_num);",
