    "body": [
      "// P[i] = iの最小の素因数",
      "// n以下の数に適用",
      "void spf(ll n, vector<ll>& P){",
      "    P.resize(n+10);",
      "    for(int i = 0; i <= n; i++) P[i] = i;",
      "    for(ll i = 2; i*i <= n; i++){",
