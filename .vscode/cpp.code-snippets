  "Weighted DSU (ACL Style)": {
      "prefix": "wdsu",
      "body": [
        "namespace atcoder {",
        "template <class T>",
        "struct weighted_dsu {",
        "  public:",
        "    weighted_dsu() : _n(0) {}",
        "    weighted_dsu(int n) : _n(n), parent_or_size(n, -1), diff_weight(n, 0) {}",
        "",
        "    // a から見て b が重み w になるように結合する",
        "    int merge(int a, int b, T w) {",
        "        assert(0 <= a && a < _n);",
        "        assert(0 <= b && b < _n);",
        "        int x = leader(a), y = leader(b);",
        "        if (x == y) return x;",
        "",
        "        // 根同士の相対的な重みを計算",
        "        T w_x_to_y = w + weight(a) - weight(b);",
        "",
        "        if (-parent_or_size[x] < -parent_or_size[y]) {",
        "            std::swap(x, y);",
        "            w_x_to_y = -w_x_to_y;",
        "        }",
        "        parent_or_size[x] += parent_or_size[y];",
        "        parent_or_size[y] = x;",
        "        diff_weight[y] = w_x_to_y;",
        "        return x;",
        "    }",
        "",
        "    bool same(int a, int b) {",
        "        assert(0 <= a && a < _n);",
        "        assert(0 <= b && b < _n);",
        "        return leader(a) == leader(b);",
        "    }",
        "",
        "    int leader(int a) {",
        "        assert(0 <= a && a < _n);",
        "        if (parent_or_size[a] < 0) return a;",
        "        int r = leader(parent_or_size[a]);",
        "        diff_weight[a] += diff_weight[parent_or_size[a]]; // 経路圧縮のついでに重みを累積",
        "        return parent_or_size[a] = r;",
        "    }",
        "",
        "    // 根からの絶対的な重みを取得する関数",
        "    T weight(int a) {",
        "        assert(0 <= a && a < _n);",
        "        leader(a); // 事前に経路圧縮",
        "        return diff_weight[a];",
        "    }",
        "",
        "    // aとbが連結のとき aから見たbの相対的な距離を返す",
        "    T diff(int a, int b) {",
        "        assert(same(a, b));",
        "        return weight(b) - weight(a);",
        "    }",
        "",
        "    long long size(int a) {",
        "        assert(0 <= a && a < _n);",
        "        return (long long)(-parent_or_size[leader(a)]);",
        "    }",
        "",
        "    std::vector<std::vector<int>> groups() {",
        "        std::vector<int> leader_buf(_n), group_size(_n);",
        "        for (int i = 0; i < _n; i++) {",
        "            leader_buf[i] = leader(i);",
        "            group_size[leader_buf[i]]++;",
        "        }",
        "        std::vector<std::vector<int>> result(_n);",
        "        for (int i = 0; i < _n; i++) {",
        "            result[i].reserve(group_size[i]);",
        "        }",
        "        for (int i = 0; i < _n; i++) {",
        "            result[leader_buf[i]].push_back(i);",
        "        }",
        "        result.erase(",
        "            std::remove_if(result.begin(), result.end(),",
        "                           [&](const std::vector<int>& v) { return v.empty(); }),",
        "            result.end());",
        "        return result;",
        "    }",
        "",
        "  private:",
        "    int _n;",
        "    std::vector<int> parent_or_size;",
        "    std::vector<T> diff_weight; // 親ノードとの相対的な重みを記録",
        "};",
        "}",
        "template <class T> using wdsu = atcoder::weighted_dsu<T>;",
      "// wdsu<ll> uf(n)",
      "// diff(x,y)  xから見たyの位置",
      "// weight(x)  根からxの距離",
      "// merge(x,y,w)  xから見てyの位置がwになるように結合"
      ],
      "description": "AtCoder Library (ACL) スタイルに準拠した重み付きUnion-Find"
