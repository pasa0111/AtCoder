		"  public:",
		"    dsu() : _n(0) {}",
		"    dsu(int n) : _n(n), parent_or_size(n, -1) {}",
		"    int merge(int a, int b) {",
		"        assert(0 <= a && a < _n);",
		"        assert(0 <= b && b < _n);",
		"        int x = leader(a), y = leader(b);",
		"        if (x == y) return x;",
