      "        std::vector<std::vector<int>> groups(group_num);",
      "        for (int i = 0; i < group_num; i++) groups[i].reserve(counts[i]);",
      "        for (int i = 0; i < _n; i++) groups[ids[i]].push_back(i);",
      "        ",
      "        return groups;",
